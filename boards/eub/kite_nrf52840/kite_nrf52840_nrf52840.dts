/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include <nordic/nrf52840_partition.dtsi>
#include "kite_nrf52840_nrf52840-pinctrl.dtsi"
#include "kite_nrf52840_nrf52840-connectors-gpio.dtsi"
#include "kite_nrf52840_nrf52840-connectors-pinctrl.dtsi"

/ {
	model = "Kite nRF52840";
	compatible = "eub,kite-nrf52840";

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,uart-mcumgr = &uart0;
		zephyr,bt-mon-uart = &uart0;
		zephyr,bt-c2h-uart = &uart0;
		zephyr,ieee802154 = &ieee802154;
	};

	/* These aliases are provided for compatibility with samples */
	aliases {
		led0 = &green_led;
		led1 = &orange_led;
		pwm-led0 = &pwm_led0;
		sw0 = &user_button;
		mcuboot-button0 = &user_button;
		mcuboot-led0 = &green_led;
		watchdog0 = &wdt0;
	};

	leds {
		compatible = "gpio-leds";
		green_led: green_led {
			gpios = <&gpio0 24 GPIO_ACTIVE_HIGH>;
		};
		orange_led: orange_led {
			gpios = <&gpio0 13 GPIO_ACTIVE_HIGH>;
		};
	};

	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm0 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
		};
	};

	buttons {
		compatible = "gpio-keys";
		user_button: user_button {
			gpios = <&gpio1 7 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
		};
	};

	en_pmod1: pmod1-pwr-ctrl {
		compatible = "regulator-fixed-sync", "regulator-fixed";
		status = "okay";
		regulator-name = "EN_PMOD1";
		enable-gpios = <&gpio1 4 GPIO_ACTIVE_HIGH>;
		regulator-boot-on;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_DCDC>;
};

&adc {
	status = "okay";
};

&gpiote {
	status = "okay";
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	status = "okay";
};

&pwm0 {
	status = "okay";
	pinctrl-0 = <&pwm0_default>;
	pinctrl-1 = <&pwm0_sleep>;
	pinctrl-names = "default", "sleep";
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&uart_pmod1_default>;
	pinctrl-1 = <&uart_pmod1_sleep>;
	pinctrl-names = "default", "sleep";
};

&ieee802154 {
	status = "okay";
};

zephyr_udc0: &usbd {
	status = "okay";
};

&uicr {
	gpio-as-nreset;
};
